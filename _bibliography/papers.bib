@inproceedings{bellard2025agentic,
  abbr={IEEE BigData},
  bibtex_show={true},
  title={Development and Evaluation of an Agentic RAG with Embedded LLM-as-a Judge for Heart Failure Management: A Pilot Study},
  author={Bellard, B. and Liu, Xinyi Celine and Lohani, R. and Raza, S. and Velmovitsky, P. E. and Pham, Q. and Saha, S.},
  booktitle={2025 IEEE International Conference on Big Data (BigData)},
  pages={7770--7774},
  year={2025},
  organization={IEEE},
  html={https://ieeexplore.ieee.org/abstract/document/11402164},
  abstract={This pilot study develops and evaluates an agentic Retrieval-Augmented Generation (RAG) system for heart failure management, integrating an LLM-as-a-Judge (LLM-J) to autonomously critique and refine a primary chatbot's outputs. The LLM-J evaluates responses on five dimensions—accuracy, safety, robustness, empathy, and clarity—within a two-stage feedback loop. Testing on 25 synthetic HF question–answer (QA) pairs demonstrated significant improvement in the robustness of responses (+0.39 mean Δ) by adding critical safety thresholds and escalation guidance, while maintaining high accuracy, safety, and empathy. A small subset (4.3%) failed the second safety gate due to contextual drift, triggering a reliable fallback message. The system operated with a mean total cycle time of 15.74 seconds and a mean cost of $0.00312 per query, confirming its scalability for real-time clinical support. This work demonstrates the feasibility of a lightweight, self-correcting AI governance layer to enhance the safety and reliability of patient-facing digital health tools.},
  selected={true}
}
